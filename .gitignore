# JavaScript dependencies and package-manager diagnostics
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Expo and Metro caches
.expo/
.expo-shared/
.metro-health-check*
.cache/

# Generated build output and coverage
dist/
build/
web-build/
coverage/

# Local configuration and secrets (keep example templates tracked)
.env
.env.*
!.env.example
*.local

# Mobile signing material
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.cer
*.der

# OS and editor state
.DS_Store
*.swp

# The planned Expo managed app will not commit generated native projects.
# Remove these entries if ios/ or android/ becomes intentionally maintained.
ios/
android/
