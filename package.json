{
  "name": "n-m",
  "version": "0.0.0",
  "private": true,
  "description": "An expanding-grid puzzle game built with Expo and React Native",
  "main": "node_modules/expo/AppEntry.js",
  "license": "MIT",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "lint:app": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:engine": "node --import tsx --test src/engine/*.test.ts",
    "check": "npm run format:check && npm run lint:md && npm run lint:app && npm run typecheck && npm run test:engine",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.8",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "markdownlint-cli2": {
      "smol-toml": "1.8.0"
    }
  },
  "dependencies": {
    "expo": "^57.0.24",
    "expo-dev-client": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
