{
  "name": "n-m",
  "version": "0.0.0",
  "private": true,
  "description": "Design documentation and repository tooling for n^m",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "check": "npm run format:check && npm run lint:md"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.8"
  },
  "overrides": {
    "smol-toml": "1.8.0"
  }
}
